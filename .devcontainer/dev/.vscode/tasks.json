            },
            "problemMatcher": [],
        },
        {
            "label": "rebuild package",
            "dependsOn": [
                "compile tofurengo.data",
                "pdoc3 package tofurengo",
                "build package tofurengo",
                "install package tofurengo",
                "build package tofurengo-data-mj-v6-02-201",
                "install package tofurengo-data-mj-v6-02-201",
                "build package tofurengo-data-mj-v6-02-201-onka",
                "install package tofurengo-data-mj-v6-02-201-onka",
                "build package tofurengo-data-mj-plus-v4-10",
                "install package tofurengo-data-mj-plus-v4-10",
                "build package tofurengo-data-mj-plusx-v1-20",
                "install package tofurengo-data-mj-plusx-v1-20",
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
    ]

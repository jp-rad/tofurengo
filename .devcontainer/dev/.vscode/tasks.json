    "version": "2.0.0",
    "tasks": [
        {
            "label": "pdoc3 package tofurengo",
            "type": "shell",
            "command": "pdoc3",
            "args": [
                "tofurengo",
                "-o",
                "../../docs",
                "--force",
                "--html",
                "--template-dir", "../../docs_templates",
            ],
            "options": {
                "cwd": "${workspaceFolder}/code/tofurengo/src",
            },
            "problemMatcher": []
        },
        {
            "label": "build package tofurengo",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/code/tofurengo",
            },
            "problemMatcher": []
        },
        {
            "label": "install package tofurengo",
            "type": "shell",
            "command": "pip3",
            "args": [
                "install",
                "--upgrade",
                "--no-deps",
                ".",
            ],
            "options": {
                "cwd": "${workspaceFolder}/code/tofurengo",
            },
            "problemMatcher": []
        },
        {
